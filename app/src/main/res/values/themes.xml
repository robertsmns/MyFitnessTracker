<?xml version="1.0" encoding="utf-8"?>
<!-- res/values/themes.xml -->
<resources>
    <style name="Theme.MyFitnessTracker" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Main Brand Colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/surface</item>
        <item name="colorPrimaryContainer">@color/primary</item>
        <item name="colorOnPrimaryContainer">@color/surface</item>

        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_surface</item>

        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface</item> <!-- Popup Hintergrund -->
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>

        <item name="colorSecondaryContainer">@color/navigation_selection_color</item> <!-- Auswahl-Hintergrund Navigation -->
        <item name="colorOnSecondaryContainer">@color/primary</item>

        <item name="colorOutline">@color/primary</item>
        <item name="colorError">@color/error</item>

        <!-- Im Light Mode: Statusleiste hell, Icons (Uhrzeit etc.) dunkel -->
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>
