<?xml version="1.0" encoding="utf-8"?>
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <!-- Login -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.schule.myfitnessTracker.ui.auth.LoginFragment"
        android:label="Login">
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_dashboardFragment"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Registrierung -->
    <fragment
        android:id="@+id/registerFragment"
        android:name="com.schule.myfitnessTracker.ui.auth.RegisterFragment"
        android:label="Registrieren">
        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/registerFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Dashboard (Startseite) -->
    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.schule.myfitnessTracker.ui.dashboard.DashboardFragment"
        android:label="Dashboard" />

    <!-- Karte mit Live-Tracking -->
    <fragment
        android:id="@+id/mapFragment"
        android:name="com.schule.myfitnessTracker.ui.tracking.MapFragment"
        android:label="Karte" />

    <!-- Trainings-Historie -->
    <fragment
        android:id="@+id/historyFragment"
        android:name="com.schule.myfitnessTracker.ui.history.HistoryFragment"
        android:label="Historie" />

    <!-- Optionen / Einstellungen -->
    <fragment
        android:id="@+id/optionsFragment"
        android:name="com.schule.myfitnessTracker.ui.options.OptionsFragment"
        android:label="Optionen" />

</navigation>
